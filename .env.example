# Use Compose's direct BuildKit integration; retain incremental object caching.
COMPOSE_BAKE=false
# Copy to .env and set this to a self-contained Python distribution (not a venv).
NINFER_PYTHON_CONTEXT=/absolute/path/to/self-contained-python-3.11
NINFER_ROCM_CONTEXT=/opt/rocm/core-10.0
NINFER_MODELS_DIR=/absolute/path/to/models
# Relative to NINFER_MODELS_DIR. This is the explicit selected DFlash artifact.
NINFER_MODEL=qwen3.8-27b-r9700-lq4/qwen3.8-27b-r9700-lq4.ninfer
NINFER_BUILD_JOBS=8
NINFER_DRM_RENDER_NODE=/dev/dri/renderD128
NINFER_CONCURRENCY=6
NINFER_DRAFT_TOKENS=7
NINFER_RAM_CACHE_MIB=12288
# Retained system prefixes, inside the same RAM budget; 0 disables.
NINFER_SYSTEM_PROMPTS=0
NINFER_DISK_CACHE_MIB=25600
NINFER_DISK_CACHE_DIR=./.cache/ninfer
