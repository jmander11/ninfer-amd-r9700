# Copy to .env and set this to a self-contained Python distribution (not a venv).
# On the maintainer host:
NINFER_PYTHON_CONTEXT=/ssdpool2nvme/local_llm/ninfer-sandbox/out/python/cpython-3.11.16-linux-x86_64-gnu
NINFER_ROCM_CONTEXT=/opt/rocm/core-10.0
NINFER_MODELS_DIR=/ssdpool2nvme/local_llm/models
# Relative to NINFER_MODELS_DIR. This is the explicit selected DFlash artifact.
NINFER_MODEL=qwen3.8-27b-r9700-q4-fp8-selective-cap/qwen3.8-27b-r9700-q4-fp8-selective-cap-n16k16-dflash2-q4-eval.ninfer
NINFER_BUILD_JOBS=4
NINFER_DRM_RENDER_NODE=/dev/dri/renderD128
NINFER_BIND_ADDRESS=127.0.0.1
NINFER_PORT=8080
NINFER_MAX_CONTEXT=32768
NINFER_CONCURRENCY=1
NINFER_DRAFT_TOKENS=5
NINFER_RAM_CACHE_MIB=4096
NINFER_DISK_CACHE_MIB=32768
