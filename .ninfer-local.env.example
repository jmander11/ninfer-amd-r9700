# Copy to .ninfer-local.env and edit. Keep one shared lock across GPU checkouts.
# Source this file before manual GPU commands; maintainer shell runners load it.
export NINFER_GPU_LOCK=/absolute/path/to/shared/gpu.lock
export NINFER_PYTHON=/absolute/path/to/python3.11
export NINFER_OFFICIAL_TOKENIZER_DIR=/absolute/path/to/qwen3.8-27b-bf16
export NINFER_R9700_PCI_BUS_ID=0000:01:00.0
export NINFER_DRM_RENDER_NODE=/dev/dri/renderD128
