namespace {
namespace prod = ninfer::ops::r9700::linear;
namespace eager = ninfer::ops::r9700::eager;
constexpr std::array<std::uint32_t,11> kTimingT{1,2,3,4,8,12,16,24,36,48,2048};
constexpr unsigned kTrials=7;
struct Shape { const char* role; std::uint32_t n,k,calls; bool fused; };
constexpr Shape kShapes[]={{"value_z",12288,5120,48,false},
                           {"gdn_output",5120,6144,48,false},
                           {"mlp_down",5120,17408,64,true}};
void check(hipError_t e,const char* w){if(e!=hipSuccess)throw std::runtime_error(std::string(w)+": "+hipGetErrorString(e));}
template<class T>struct Dev{T*p{};std::size_t n{};explicit Dev(std::size_t x):n(x){check(hipMalloc(&p,n*sizeof(T)),"malloc");}~Dev(){if(p)(void)hipFree(p);}Dev(const Dev&)=delete;};
struct Stream{hipStream_t p{};Stream(){check(hipStreamCreate(&p),"stream create");}~Stream(){if(p)(void)hipStreamDestroy(p);}Stream(const Stream&)=delete;};
template<class T>void upload(Dev<T>&d,const std::vector<T>&h){check(hipMemcpy(d.p,h.data(),h.size()*sizeof(T),hipMemcpyHostToDevice),"upload");}
std::uint16_t hbits(float x){__half h=__float2half_rn(x);std::uint16_t b;std::memcpy(&b,&h,2);return b;}
float hval(std::uint16_t b){__half h;std::memcpy(&h,&b,2);return __half2float(h);}
std::size_t p128(std::uint32_t n,std::uint32_t g,std::uint32_t p,std::uint32_t gs){return (((std::size_t(n>>4)*gs+g)*8+p)*16+(n&15));}
std::size_t p64(std::uint32_t n,std::uint32_t g,std::uint32_t p,std::uint32_t gs){return (((std::size_t(n>>4)*gs+g)*4+p)*16+(n&15));}
std::size_t sidx(std::uint32_t n,std::uint32_t g,std::uint32_t gs){return (std::size_t(n>>4)*gs+g)*16+(n&15);}
int snib(std::uint8_t v,unsigned shift){int x=(v>>shift)&15;return x>=8?x-16:x;}
int unib(std::uint8_t v,unsigned shift){return (v>>shift)&15;}

struct HostA{std::vector<std::uint8_t>lo,hi;std::vector<std::uint16_t>s;std::uint32_t status{};};
HostA quant_host(const std::vector<hip_bfloat16>&in,std::uint32_t t,std::uint32_t k,std::uint32_t group,bool fused){
 HostA q;q.lo.resize(std::size_t(t)*k/2);q.hi.resize(q.lo.size());q.s.resize(std::size_t(t)*(k/group));
 for(unsigned m=0;m<t;++m)for(unsigned g=0;g<k/group;++g){std::vector<float>v(group);float mx=0;
  for(unsigned j=0;j<group;++j){float x;if(fused){float a=float(in[std::size_t(m)*2*k+g*group+j]);float b=float(in[std::size_t(m)*2*k+k+g*group+j]);x=float(hip_bfloat16((a/(1+std::exp(-a)))*b));}else x=float(in[std::size_t(m)*k+g*group+j]);if(!std::isfinite(x)){q.status|=1;x=0;}v[j]=x;mx=std::max(mx,std::abs(x));}
  auto sb=mx==0?0:hbits(mx/127);if(mx&&sb==0)sb=1;if(!std::isfinite(hval(sb))){q.status|=2;sb=0;}q.s[std::size_t(m)*(k/group)+g]=sb;float sc=hval(sb);
  for(unsigned j=0;j<group;j+=2){int z[2];for(unsigned x=0;x<2;++x)z[x]=sc==0?0:std::max(-127,std::min(127,int(std::nearbyint(v[j+x]/sc))));auto o=(std::size_t(m)*k+g*group+j)/2;
   int l0=z[0]&15,l1=z[1]&15;q.lo[o]=l0|(l1<<4);q.hi[o]=((z[0]-l0)/16&15)|(((z[1]-l1)/16&15)<<4);}}
 return q;
}
struct HostW{std::vector<std::uint64_t>pairs;std::vector<std::uint16_t>scales;};
HostW make_w(const Shape&s,unsigned group,bool dense=false){unsigned gs=s.k/group,pairs=group/16;HostW w;w.pairs.resize(std::size_t(s.n)*s.k/16);w.scales.resize(std::size_t(s.n)*gs);
 for(unsigned n=0;n<s.n;++n)for(unsigned g=0;g<gs;++g){const unsigned paired_group=group==64?g/2U:g;w.scales[sidx(n,g,gs)]=hbits(float(1+((n*13+paired_group*7)&15))/64.0f);for(unsigned p=0;p<pairs;++p){std::uint64_t x=0;for(unsigned j=0;j<16;++j){const unsigned k=g*group+p*16+j;std::uint32_t mix=n*1664525U+k*1013904223U+(n^(k>>3U))*2246822519U;mix^=mix>>13U;mix^=mix>>22U;int q=dense?int(mix&15U)-8:((g<2&&j<4)?int((n+j*3+g*5)%15)-7:0);x|=std::uint64_t(q&15)<<(j*4);}auto ix=group==128?p128(n,g,p,gs):p64(n,g,p,gs);w.pairs[ix]=x;}}
 return w;
}
void timing_weights_match(const Shape&s,const HostW&g128,const HostW&g64){const unsigned gs128=s.k/128,gs64=s.k/64;for(unsigned n=0;n<s.n;++n)for(unsigned g=0;g<gs128;++g){const auto cs=g128.scales[sidx(n,g,gs128)];if(g64.scales[sidx(n,2*g,gs64)]!=cs||g64.scales[sidx(n,2*g+1,gs64)]!=cs)throw std::runtime_error("timing scale pair differs");for(unsigned p=0;p<8;++p){const auto a=g128.pairs[p128(n,g,p,gs128)];const unsigned g6=2*g+p/4,pp=p%4;const auto b=g64.pairs[p64(n,g6,pp,gs64)];if(a!=b)throw std::runtime_error("timing logical signed-Q4 codes differ");}}}
std::vector<hip_bfloat16> make_input(const Shape&s,unsigned t,bool dense){std::vector<hip_bfloat16>x(std::size_t(t)*s.k*(s.fused?2:1));for(unsigned m=0;m<t;++m)for(unsigned k=0;k<s.k;++k){float v=(dense||k<256)?float(int((m*17+k*11)%31)-15)/16:0;x[std::size_t(m)*(s.fused?2*s.k:s.k)+k]=hip_bfloat16(v);if(s.fused)x[std::size_t(m)*2*s.k+s.k+k]=hip_bfloat16((dense||k<256)?float(int((m*5+k*7)%23)-11)/16:0);}return x;}

struct Candidate {Dev<std::uint8_t>lo,hi;Dev<std::uint16_t>as;Dev<std::uint32_t>status;Dev<std::uint64_t>w;Dev<std::uint16_t>ws;Dev<hip_bfloat16>out;std::size_t logical_out{};
 Candidate(unsigned t,const Shape&s):lo(std::size_t(t)*s.k/2),hi(lo.n),as(std::size_t(t)*(s.k/128)),status(1),w(std::size_t(s.n)*s.k/16),ws(std::size_t(s.n)*(s.k/128)),out(std::size_t(t)*s.n+32),logical_out(std::size_t(t)*s.n){}
};
struct Control {Dev<std::uint8_t>storage;Dev<std::uint64_t>w;Dev<std::uint16_t>ws;Dev<hip_bfloat16>out,fused_materialized;prod::A8G64ActivationWorkspace a{};
 Control(unsigned t,const Shape&s):storage(prod::a8q4g64_activation_workspace_capacity_bytes(t,s.k)),w(std::size_t(s.n)*s.k/16),ws(std::size_t(s.n)*(s.k/64)),out(std::size_t(t)*s.n),fused_materialized(std::size_t(t)*(s.fused?s.k:1U)+32U){check(prod::a8q4g64_bind_activation_workspace(storage.p,storage.n,t,s.k,&a),"bind control");}
};
A8G128Q4G128QualificationArgs cargs(const Shape&s,unsigned t,const Dev<hip_bfloat16>&in,Candidate&c){return {in.p,c.lo.p,c.hi.p,c.as.p,c.status.p,c.w.p,c.ws.p,c.out.p,c.lo.n,c.as.n*2,c.w.n*8,c.ws.n*2,c.logical_out*2,t,s.n,s.k,s.fused};}
void cand_all(const Shape&s,unsigned t,const Dev<hip_bfloat16>&in,Candidate&c,hipStream_t stream){check(a8g128_q4g128_qualification_run(cargs(s,t,in,c),stream),"candidate complete");}
void ctrl_prepare(const Shape&s,unsigned t,const Dev<hip_bfloat16>&in,Control&c,hipStream_t stream){
 if(s.fused&&t==2048){check(prod::fused_silu_a8g64_prepare(in.p,c.a,stream),"control fused prepare");return;}
 const hip_bfloat16* represented=in.p;
 if(s.fused){
  eager::SiluMulStridedShape shape{};shape.extent[0]=s.k;shape.extent[1]=t;shape.gate_stride[0]=1;shape.up_stride[0]=1;shape.gate_stride[1]=2U*s.k;shape.up_stride[1]=2U*s.k;const std::uint64_t outer=std::uint64_t(2U*s.k)*t;shape.gate_stride[2]=outer;shape.up_stride[2]=outer;shape.gate_stride[3]=outer;shape.up_stride[3]=outer;
  check(eager::silu_mul_bf16_strided(in.p,in.p+s.k,c.fused_materialized.p,std::size_t(t)*s.k,shape,stream),"control product eager silu_mul");represented=c.fused_materialized.p;
 }
 check(prod::a8g64_quantize_activation({represented,c.a},stream),"control prepare");
}
void ctrl_gemm(const Shape&s,unsigned t,Control&c,hipStream_t stream){prod::A8Q4G64LinearArgs a{c.a.low_codes,c.a.low_code_bytes,c.a.high_codes,c.a.high_code_bytes,c.a.scales,c.a.scale_bytes,c.a.status,reinterpret_cast<std::uint8_t*>(c.w.p),c.w.n*8,c.ws.p,c.ws.n*2,c.out.p,t,s.n,s.k,s.k};if(t==2048)check(prod::a8q4g64_linear_prefill_cta(a,stream),"control prefill");else check(prod::a8q4g64_linear_wmma32(a,stream),"control wave");}

std::vector<hip_bfloat16> oracle(const Shape&s,unsigned t,const HostA&a,const HostW&w,unsigned group){std::vector<hip_bfloat16>o(std::size_t(t)*s.n);unsigned gs=s.k/group,pairs=group/16;
 // The correctness fixture is deliberately sparse after two complete
 // represented groups.  Prove that boundary, then evaluate every output from
 // the complete logical formula without paying for known zero groups.
 for(unsigned m=0;m<t;++m)for(unsigned g=2;g<gs;++g)if(a.s[std::size_t(m)*gs+g]!=0)throw std::runtime_error("oracle sparse-group premise");
 for(unsigned m=0;m<t;++m)for(unsigned n=0;n<s.n;++n){double sum=0;for(unsigned g=0;g<2;++g){int dot=0;for(unsigned p=0;p<pairs;++p){auto ww=w.pairs[group==128?p128(n,g,p,gs):p64(n,g,p,gs)];for(unsigned j=0;j<16;++j){unsigned k=g*group+p*16+j,off=(std::size_t(m)*s.k+k)/2,sh=(k&1)*4;int aq=unib(a.lo[off],sh)+16*snib(a.hi[off],sh);int wq=int((ww>>(j*4))&15);if(wq>=8)wq-=16;dot+=aq*wq;}}sum=std::fma(double(dot),double(hval(a.s[std::size_t(m)*gs+g]))*hval(w.scales[sidx(n,g,gs)]),sum);}o[std::size_t(m)*s.n+n]=hip_bfloat16(float(sum));}return o;}
void exact_codec(const HostA&h,const Candidate&c){std::vector<std::uint8_t>lo(h.lo.size()),hi(h.hi.size());std::vector<std::uint16_t>s(h.s.size());std::uint32_t st=99;check(hipMemcpy(lo.data(),c.lo.p,lo.size(),hipMemcpyDeviceToHost),"lo");check(hipMemcpy(hi.data(),c.hi.p,hi.size(),hipMemcpyDeviceToHost),"hi");check(hipMemcpy(s.data(),c.as.p,s.size()*2,hipMemcpyDeviceToHost),"scales");check(hipMemcpy(&st,c.status.p,4,hipMemcpyDeviceToHost),"status");if(lo!=h.lo||hi!=h.hi||s!=h.s||st!=h.status)throw std::runtime_error("candidate codec differs from independent host codec");}
void exact_control_codec(const HostA&h,const Control&c){std::vector<std::uint8_t>lo(h.lo.size()),hi(h.hi.size());std::vector<std::uint16_t>s(h.s.size());std::uint32_t st=99;check(hipMemcpy(lo.data(),c.a.low_codes,lo.size(),hipMemcpyDeviceToHost),"control low");check(hipMemcpy(hi.data(),c.a.high_codes,hi.size(),hipMemcpyDeviceToHost),"control high");check(hipMemcpy(s.data(),c.a.scales,s.size()*2,hipMemcpyDeviceToHost),"control scales");check(hipMemcpy(&st,c.a.status,4,hipMemcpyDeviceToHost),"control status");if(lo!=h.lo||hi!=h.hi||s!=h.s||st!=h.status)throw std::runtime_error("small-T fused control codec differs from production-formula host oracle");}
void exact_product_fused_materialization(const std::vector<hip_bfloat16>&in,const Shape&s,unsigned t,const Control&c){std::vector<hip_bfloat16>a(std::size_t(t)*s.k);check(hipMemcpy(a.data(),c.fused_materialized.p,a.size()*2,hipMemcpyDeviceToHost),"control fused materialization");for(unsigned m=0;m<t;++m)for(unsigned k=0;k<s.k;++k){float gate=float(in[std::size_t(m)*2*s.k+k]),up=float(in[std::size_t(m)*2*s.k+s.k+k]);hip_bfloat16 expected((gate/(1+std::exp(-gate)))*up);if(a[std::size_t(m)*s.k+k].data!=expected.data)throw std::runtime_error("product eager fused BF16 materialization differs from host formula");}}
void exact_output(const std::vector<hip_bfloat16>&e,const Dev<hip_bfloat16>&d){std::vector<hip_bfloat16>a(e.size());check(hipMemcpy(a.data(),d.p,a.size()*2,hipMemcpyDeviceToHost),"out");for(std::size_t i=0;i<a.size();++i){unsigned steps=a[i].data>e[i].data?a[i].data-e[i].data:e[i].data-a[i].data;if(steps>2){std::ostringstream m;m<<"complete represented FP64 oracle differs at "<<i<<" expected="<<e[i].data<<" actual="<<a[i].data<<" bf16_steps="<<steps;throw std::runtime_error(m.str());}}}
void rejected_args_no_clobber(const Shape&s,const Dev<hip_bfloat16>&in,Candidate&c){auto good=cargs(s,1,in,c);std::vector<std::uint8_t>blo(c.lo.n),bhi(c.hi.n);std::vector<std::uint16_t>bas(c.as.n);std::vector<std::uint32_t>bst(1);std::vector<hip_bfloat16>bout(c.out.n);check(hipMemcpy(blo.data(),c.lo.p,c.lo.n,hipMemcpyDeviceToHost),"guard low");check(hipMemcpy(bhi.data(),c.hi.p,c.hi.n,hipMemcpyDeviceToHost),"guard high");check(hipMemcpy(bas.data(),c.as.p,c.as.n*2,hipMemcpyDeviceToHost),"guard scales");check(hipMemcpy(bst.data(),c.status.p,4,hipMemcpyDeviceToHost),"guard status");check(hipMemcpy(bout.data(),c.out.p,c.out.n*2,hipMemcpyDeviceToHost),"guard output");auto reject=[&](A8G128Q4G128QualificationArgs bad){if(a8g128_q4g128_qualification_run(bad,nullptr)!=hipErrorInvalidValue)throw std::runtime_error("invalid qualification args accepted");std::vector<std::uint8_t>lo(c.lo.n),hi(c.hi.n);std::vector<std::uint16_t>as(c.as.n);std::vector<std::uint32_t>st(1);std::vector<hip_bfloat16>out(c.out.n);check(hipMemcpy(lo.data(),c.lo.p,c.lo.n,hipMemcpyDeviceToHost),"guard low after");check(hipMemcpy(hi.data(),c.hi.p,c.hi.n,hipMemcpyDeviceToHost),"guard high after");check(hipMemcpy(as.data(),c.as.p,c.as.n*2,hipMemcpyDeviceToHost),"guard scales after");check(hipMemcpy(st.data(),c.status.p,4,hipMemcpyDeviceToHost),"guard status after");check(hipMemcpy(out.data(),c.out.p,c.out.n*2,hipMemcpyDeviceToHost),"guard output after");if(lo!=blo||hi!=bhi||as!=bas||st!=bst)throw std::runtime_error("rejected call clobbered workspace/status");for(std::size_t i=0;i<out.size();++i)if(out[i].data!=bout[i].data)throw std::runtime_error("rejected call clobbered output");};
 auto b=good;b.input=nullptr;reject(b);b=good;b.activation_low=nullptr;reject(b);b=good;b.activation_high=nullptr;reject(b);b=good;b.activation_scales=nullptr;reject(b);b=good;b.status=nullptr;reject(b);b=good;b.weight_pairs=nullptr;reject(b);b=good;b.weight_scales=nullptr;reject(b);b=good;b.output=nullptr;reject(b);
 b=good;b.input=reinterpret_cast<const hip_bfloat16*>(reinterpret_cast<std::uintptr_t>(b.input)+1);reject(b);b=good;b.activation_low+=1;reject(b);b=good;b.activation_high+=1;reject(b);b=good;b.activation_scales=reinterpret_cast<std::uint16_t*>(reinterpret_cast<std::uintptr_t>(b.activation_scales)+1);reject(b);b=good;b.status=reinterpret_cast<std::uint32_t*>(reinterpret_cast<std::uintptr_t>(b.status)+1);reject(b);b=good;b.weight_pairs=reinterpret_cast<const std::uint64_t*>(reinterpret_cast<std::uintptr_t>(b.weight_pairs)+1);reject(b);b=good;b.weight_scales=reinterpret_cast<const std::uint16_t*>(reinterpret_cast<std::uintptr_t>(b.weight_scales)+1);reject(b);b=good;b.output=reinterpret_cast<hip_bfloat16*>(reinterpret_cast<std::uintptr_t>(b.output)+1);reject(b);
 b=good;--b.activation_plane_bytes;reject(b);b=good;--b.activation_scale_bytes;reject(b);b=good;--b.weight_code_bytes;reject(b);b=good;--b.weight_scale_bytes;reject(b);b=good;--b.output_bytes;reject(b);b=good;b.activation_high=b.activation_low;reject(b);b=good;b.output=reinterpret_cast<hip_bfloat16*>(b.activation_low);reject(b);b=good;b.tokens=5;reject(b);b=good;b.rows=128;reject(b);b=good;b.fused_silu=!b.fused_silu;reject(b);}
template<class F>double elapsed(F&&f,unsigned it,hipStream_t stream){for(unsigned i=0;i<2;++i)f();check(hipStreamSynchronize(stream),"warmup");hipEvent_t a,b;check(hipEventCreate(&a),"event");check(hipEventCreate(&b),"event");check(hipEventRecord(a,stream),"record");for(unsigned i=0;i<it;++i)f();check(hipEventRecord(b,stream),"record");check(hipEventSynchronize(b),"sync");float ms;check(hipEventElapsedTime(&ms,a,b),"elapsed");(void)hipEventDestroy(a);(void)hipEventDestroy(b);return ms;}
double median(std::array<double,kTrials>x){std::sort(x.begin(),x.end());return x[kTrials/2];}
struct Timing{Shape s;unsigned t,iterations;std::array<double,kTrials>ctrl{},cand{};};
Timing time_case(const Shape&s,unsigned t,const HostW&wc,const HostW&wb){auto input=make_input(s,t,true);Dev<hip_bfloat16>di(input.size());upload(di,input);Candidate c(t,s);Control b(t,s);upload(c.w,wc.pairs);upload(c.ws,wc.scales);upload(b.w,wb.pairs);upload(b.ws,wb.scales);Stream stream;auto lc=[&]{cand_all(s,t,di,c,stream.p);};auto lb=[&]{ctrl_prepare(s,t,di,b,stream.p);ctrl_gemm(s,t,b,stream.p);};const unsigned it=t==2048?128U:1024U;Timing z{s,t,it};for(unsigned q=0;q<kTrials;++q){if(q&1){z.cand[q]=elapsed(lc,it,stream.p);z.ctrl[q]=elapsed(lb,it,stream.p);}else{z.ctrl[q]=elapsed(lb,it,stream.p);z.cand[q]=elapsed(lc,it,stream.p);}}return z;}
void regression(){for(int q=-127;q<=127;++q){const int lo=q&15,hi=(q-lo)/16;if(lo<0||lo>15||hi<-8||hi>7||lo+16*hi!=q)throw std::runtime_error("signed-A8 nibble decomposition oracle");}for(const auto&s:kShapes){auto wh=make_w(s,128);for(unsigned t:kTimingT){auto input=make_input(s,t,false);auto ah=quant_host(input,t,s.k,128,s.fused);Dev<hip_bfloat16>di(input.size());upload(di,input);Candidate c(t,s);upload(c.w,wh.pairs);upload(c.ws,wh.scales);check(hipMemset(c.out.p,0x55,c.out.n*2),"poison output");cand_all(s,t,di,c,nullptr);check(hipDeviceSynchronize(),"regression sync");exact_codec(ah,c);exact_output(oracle(s,t,ah,wh,128),c.out);std::vector<hip_bfloat16>canary(32);check(hipMemcpy(canary.data(),c.out.p+c.logical_out,64,hipMemcpyDeviceToHost),"canary");for(auto v:canary)if(v.data!=0x5555)throw std::runtime_error("output tail canary clobbered");
 if(std::string(s.role)=="value_z"&&t==1){rejected_args_no_clobber(s,di,c);hipStream_t stream{};check(hipStreamCreate(&stream),"graph stream");hipGraph_t graph{};hipGraphExec_t exec{};check(hipStreamBeginCapture(stream,hipStreamCaptureModeGlobal),"capture begin");cand_all(s,t,di,c,stream);check(hipStreamEndCapture(stream,&graph),"capture end");check(hipGraphInstantiate(&exec,graph,nullptr,nullptr,0),"instantiate");check(hipGraphLaunch(exec,stream),"graph launch1");check(hipGraphLaunch(exec,stream),"graph launch2");check(hipStreamSynchronize(stream),"graph sync");(void)hipGraphExecDestroy(exec);(void)hipGraphDestroy(graph);(void)hipStreamDestroy(stream);exact_output(oracle(s,t,ah,wh,128),c.out);
  auto nonfinite=input;nonfinite[0].data=0x7fc1;upload(di,nonfinite);cand_all(s,t,di,c,nullptr);check(hipDeviceSynchronize(),"nonfinite sync");std::uint32_t st=0;hip_bfloat16 poisoned{};check(hipMemcpy(&st,c.status.p,4,hipMemcpyDeviceToHost),"nonfinite status");check(hipMemcpy(&poisoned,c.out.p,2,hipMemcpyDeviceToHost),"poison output");if((st&1U)==0U||poisoned.data!=0x7fc1)throw std::runtime_error("nonfinite/status poison contract");upload(di,input);cand_all(s,t,di,c,nullptr);check(hipDeviceSynchronize(),"status reset sync");check(hipMemcpy(&st,c.status.p,4,hipMemcpyDeviceToHost),"reset status");if(st!=0)throw std::runtime_error("status did not reset");}
 if(s.fused&&t==1){Control control(t,s);check(hipMemset(control.fused_materialized.p+std::size_t(t)*s.k,0x55,64),"control fused tail poison");Stream control_stream;ctrl_prepare(s,t,di,control,control_stream.p);check(hipStreamSynchronize(control_stream.p),"small-T control codec sync");exact_product_fused_materialization(input,s,t,control);std::vector<hip_bfloat16>control_canary(32);check(hipMemcpy(control_canary.data(),control.fused_materialized.p+std::size_t(t)*s.k,64,hipMemcpyDeviceToHost),"control fused tail");for(auto v:control_canary)if(v.data!=0x5555)throw std::runtime_error("product eager fused materialization tail clobbered");exact_control_codec(quant_host(input,t,s.k,64,true),control);}}}
 std::cout<<"PASS exact_shapes=3 correctness_T=1,2,3,4,8,12,16,24,36,48,2048 complete_fp64_oracle=true maximum_bf16_steps=2 codec_exact=true alignment_overlap_tail_no_clobber=true graph_replay=true status_nonfinite_reset=true\n";}
void samples(const std::array<double,kTrials>&x){std::cout<<"[";for(unsigned i=0;i<kTrials;++i){if(i)std::cout<<",";std::cout<<x[i];}std::cout<<"]";}
void benchmark(){int dev=-1,rv=0,dv=0;hipDeviceProp_t p{};check(hipGetDevice(&dev),"device");check(hipGetDeviceProperties(&p,dev),"props");check(hipRuntimeGetVersion(&rv),"runtime version");check(hipDriverGetVersion(&dv),"driver version");std::vector<Timing>z;for(const auto&s:kShapes){auto wc=make_w(s,128,true),wb=make_w(s,64,true);timing_weights_match(s,wc,wb);for(auto t:kTimingT)z.push_back(time_case(s,t,wc,wb));}std::cout<<std::setprecision(12)<<"{\"schema_version\":2,\"status\":\"measured\",\"device\":{\"ordinal\":"<<dev<<",\"name\":\""<<p.name<<"\",\"architecture\":\""<<p.gcnArchName<<"\",\"runtime_version\":"<<rv<<",\"driver_version\":"<<dv<<"},\"timing_weight_contract\":\"identical_dense_logical_signed_q4_codes_and_paired_equal_scales\",\"timing_stream_contract\":\"one_owned_nondefault_stream_per_cell;both_routes_and_events_on_same_stream\",\"timing_batch_contract\":\"T_lt_2048=1024_calls_per_event_interval;T_2048=128_calls_per_event_interval;reported_samples_are_raw_interval_ms\",\"control_boundary_contract\":\"nonfused=canonical_a8g64_prepare_plus_gemm;mlp_down_T_lt_2048=product_eager_silu_mul_bf16_strided_plus_canonical_a8g64_prepare_plus_gemm;mlp_down_T_2048=canonical_fused_silu_a8g64_prepare_plus_gemm\",\"trials\":[";for(std::size_t i=0;i<z.size();++i){if(i)std::cout<<",";auto&a=z[i];double bm=median(a.ctrl)/a.iterations,cm=median(a.cand)/a.iterations;const char*boundary=!a.s.fused?"canonical_a8g64_prepare_plus_gemm":(a.t==2048?"canonical_fused_silu_a8g64_prepare_plus_gemm":"product_eager_silu_mul_bf16_strided_plus_canonical_a8g64_prepare_plus_gemm");std::cout<<"{\"role\":\""<<a.s.role<<"\",\"tokens\":"<<a.t<<",\"rows\":"<<a.s.n<<",\"columns\":"<<a.s.k<<",\"calls\":"<<a.s.calls<<",\"iterations_per_sample\":"<<a.iterations<<",\"control_boundary\":\""<<boundary<<"\",\"control_ms\":"<<bm<<",\"candidate_ms\":"<<cm<<",\"ratio\":"<<cm/bm<<",\"control_interval_samples_ms\":";samples(a.ctrl);std::cout<<",\"candidate_interval_samples_ms\":";samples(a.cand);std::cout<<"}";}std::cout<<"]}\n";}
}
int main(int argc,char**argv){try{int dev=-1;check(hipGetDevice(&dev),"device");hipDeviceProp_t p{};check(hipGetDeviceProperties(&p,dev),"props");if(dev!=0||std::string(p.gcnArchName).find("gfx1201")!=0)throw std::runtime_error("requires device0 gfx1201");if(argc!=2)throw std::runtime_error("usage: harness --regression|--benchmark");if(std::string(argv[1])=="--regression")regression();else if(std::string(argv[1])=="--benchmark")benchmark();else throw std::runtime_error("unknown mode");return 0;}catch(const std::exception&e){std::cerr<<"FAIL "<<e.what()<<"\n";return 1;}}
