#include "a8q4_group_major_activation_qual.h"
#include "ops/r9700/eager/eager_ops.h"
#include "ops/r9700/linear/r9700_linear.h"

#include <hip/hip_fp16.h>
#include <algorithm>
#include <array>
#include <cmath>
#include <cstdint>
#include <cstring>
#include <iomanip>
#include <iostream>
#include <stdexcept>
#include <string>
#include <vector>

namespace {
namespace prod=ninfer::ops::r9700::linear;
namespace eager=ninfer::ops::r9700::eager;
constexpr unsigned kTrials=7;
struct Shape{const char*role;unsigned n,k,calls;bool fused;};
constexpr Shape kShapes[]={{"value_z",12288,5120,48,false},{"gdn_attention_output",5120,6144,64,false},{"mlp_down",5120,17408,64,true}};
void ck(hipError_t e,const char*w){if(e!=hipSuccess)throw std::runtime_error(std::string(w)+": "+hipGetErrorString(e));}
template<class T>struct Dev{T*p{};std::size_t n{};explicit Dev(std::size_t x):n(x){ck(hipMalloc(&p,n*sizeof(T)),"malloc");}~Dev(){if(p)(void)hipFree(p);}Dev(const Dev&)=delete;};
struct Stream{hipStream_t p{};Stream(){ck(hipStreamCreate(&p),"stream");}~Stream(){if(p)(void)hipStreamDestroy(p);}};
template<class T>void put(Dev<T>&d,const std::vector<T>&h){ck(hipMemcpy(d.p,h.data(),h.size()*sizeof(T),hipMemcpyHostToDevice),"upload");}
std::uint16_t hb(float x){__half h=__float2half_rn(x);std::uint16_t b;std::memcpy(&b,&h,2);return b;}
float hf(std::uint16_t b){__half h;std::memcpy(&h,&b,2);return __half2float(h);}
std::size_t wi(unsigned n,unsigned g,unsigned p,unsigned gs){return (((std::size_t(n>>4)*gs+g)*4+p)*16+(n&15));}
std::size_t si(unsigned n,unsigned g,unsigned gs){return (std::size_t(n>>4)*gs+g)*16+(n&15);}
std::size_t gm(unsigned g,unsigned t,unsigned byte,unsigned tokens){return (std::size_t(g)*tokens+t)*32+byte;}
std::size_t gs(unsigned g,unsigned t,unsigned tokens){return std::size_t(g)*tokens+t;}
int sn(std::uint8_t x,unsigned sh){int q=(x>>sh)&15;return q>=8?q-16:q;}
int un(std::uint8_t x,unsigned sh){return (x>>sh)&15;}

struct HW{std::vector<std::uint64_t>w;std::vector<std::uint16_t>s;};
HW weights(const Shape&x,bool dense){unsigned groups=x.k/64;HW z;z.w.resize(std::size_t(x.n)*x.k/16);z.s.resize(std::size_t(x.n)*groups);for(unsigned n=0;n<x.n;++n)for(unsigned g=0;g<groups;++g){z.s[si(n,g,groups)]=hb(float(65+(n*13+g*7)%15)/64);for(unsigned p=0;p<4;++p){std::uint64_t v=0;for(unsigned j=0;j<16;++j){unsigned k=g*64+p*16+j,m=n*1664525U+k*1013904223U+(n^(k>>3))*2246822519U;m^=m>>13;m^=m>>22;int q=dense?int(m&15)-8:(g<2?int((n+j*3+g*5)%15)-7:0);v|=std::uint64_t(q&15)<<(4*j);}z.w[wi(n,g,p,groups)]=v;}}return z;}
std::vector<hip_bfloat16> input(const Shape&x,unsigned t,bool dense){std::vector<hip_bfloat16>v(std::size_t(t)*x.k*(x.fused?2:1));for(unsigned m=0;m<t;++m)for(unsigned k=0;k<x.k;++k){float a=(dense||k<128)?float(int((m*17+k*11)%31)-15)/16:0;v[std::size_t(m)*x.k*(x.fused?2:1)+k]=hip_bfloat16(a);if(x.fused)v[std::size_t(m)*2*x.k+x.k+k]=hip_bfloat16((dense||k<128)?float(int((m*5+k*7)%23)-11)/16:0);}return v;}
struct HA{std::vector<std::uint8_t>lo,hi;std::vector<std::uint16_t>s;unsigned status=0;};
HA hostq(const Shape&x,unsigned t,const std::vector<hip_bfloat16>&in){unsigned groups=x.k/64;HA a;a.lo.resize(std::size_t(t)*x.k/2);a.hi.resize(a.lo.size());a.s.resize(std::size_t(t)*groups);for(unsigned m=0;m<t;++m)for(unsigned g=0;g<groups;++g){float v[64],mx=0;for(unsigned j=0;j<64;++j){float z;if(x.fused){float q=float(in[std::size_t(m)*2*x.k+g*64+j]),u=float(in[std::size_t(m)*2*x.k+x.k+g*64+j]);z=float(hip_bfloat16((q/(1+std::exp(-q)))*u));}else z=float(in[std::size_t(m)*x.k+g*64+j]);if(!std::isfinite(z)){a.status|=1;z=0;}v[j]=z;mx=std::max(mx,std::abs(z));}auto sb=mx?hb(mx/127):0;if(mx&&sb==0)sb=1;if(!std::isfinite(hf(sb))){a.status|=2;sb=0;}a.s[std::size_t(m)*groups+g]=sb;float scale=hf(sb);for(unsigned j=0;j<64;j+=2){int q[2];for(unsigned e=0;e<2;++e)q[e]=scale?std::max(-127,std::min(127,int(std::nearbyint(v[j+e]/scale)))):0;int l0=q[0]&15,l1=q[1]&15;auto o=(std::size_t(m)*x.k+g*64+j)/2;a.lo[o]=l0|(l1<<4);a.hi[o]=(((q[0]-l0)/16)&15)|((((q[1]-l1)/16)&15)<<4);}}return a;}

struct Cand{Dev<std::uint8_t>lo,hi;Dev<std::uint16_t>s;Dev<std::uint32_t>st;Dev<std::uint8_t>w;Dev<std::uint16_t>ws;Dev<hip_bfloat16>out;hip_bfloat16*outp;std::size_t logical;
 Cand(unsigned t,const Shape&x):lo(std::size_t(t)*x.k/2),hi(lo.n),s(std::size_t(t)*x.k/64),st(1),w(std::size_t(x.n)*x.k/2),ws(std::size_t(x.n)*x.k/64),out(std::size_t(t)*x.n+48),outp(out.p+16),logical(std::size_t(t)*x.n){}
};
struct Ctrl{Dev<std::uint8_t>space;Dev<std::uint8_t>w;Dev<std::uint16_t>ws;Dev<hip_bfloat16>out,materialized;prod::A8G64ActivationWorkspace a{};Ctrl(unsigned t,const Shape&x):space(prod::a8q4g64_activation_workspace_capacity_bytes(t,x.k)),w(std::size_t(x.n)*x.k/2),ws(std::size_t(x.n)*x.k/64),out(std::size_t(t)*x.n),materialized(std::size_t(t)*(x.fused?x.k:1)){ck(prod::a8q4g64_bind_activation_workspace(space.p,space.n,t,x.k,&a),"bind");}};
A8Q4GroupMajorArgs args(const Shape&x,unsigned t,const Dev<hip_bfloat16>&in,Cand&c){return {in.p,in.n*2,c.lo.p,c.hi.p,c.s.p,c.st.p,c.w.p,c.ws.p,c.outp,c.lo.n,c.s.n*2,c.w.n,c.ws.n*2,c.logical*2,t,x.n,x.k,x.fused};}
void candidate(const Shape&x,unsigned t,const Dev<hip_bfloat16>&in,Cand&c,hipStream_t s){ck(a8q4_group_major_activation_run(args(x,t,in,c),s),"candidate");}
void control(const Shape&x,unsigned t,const Dev<hip_bfloat16>&in,Ctrl&c,hipStream_t s){const hip_bfloat16*represented=in.p;if(x.fused&&t==2048)ck(prod::fused_silu_a8g64_prepare(in.p,c.a,s),"fused prepare");else{if(x.fused){eager::SiluMulStridedShape sh{};sh.extent[0]=x.k;sh.extent[1]=t;sh.gate_stride[0]=sh.up_stride[0]=1;sh.gate_stride[1]=sh.up_stride[1]=2U*x.k;std::uint64_t outer=std::uint64_t(2U*x.k)*t;sh.gate_stride[2]=sh.up_stride[2]=sh.gate_stride[3]=sh.up_stride[3]=outer;ck(eager::silu_mul_bf16_strided(in.p,in.p+x.k,c.materialized.p,std::size_t(t)*x.k,sh,s),"eager fused boundary");represented=c.materialized.p;}ck(prod::a8g64_quantize_activation({represented,c.a},s),"prepare");}prod::A8Q4G64LinearArgs a{c.a.low_codes,c.a.low_code_bytes,c.a.high_codes,c.a.high_code_bytes,c.a.scales,c.a.scale_bytes,c.a.status,c.w.p,c.w.n,c.ws.p,c.ws.n*2,c.out.p,t,x.n,x.k,x.k};if(t==2048)ck(prod::a8q4g64_linear_prefill_cta(a,s),"prefill");else ck(prod::a8q4g64_linear_wmma32(a,s),"wave");}
void uploadw(const HW&h,Cand&c,Ctrl&b){std::vector<std::uint8_t>w(h.w.size()*8);std::memcpy(w.data(),h.w.data(),w.size());put(c.w,w);put(b.w,w);put(c.ws,h.s);put(b.ws,h.s);}

void codec(const Shape&x,unsigned t,const HA&h,Cand&c){std::vector<std::uint8_t>lo(c.lo.n),hi(c.hi.n);std::vector<std::uint16_t>s(c.s.n);unsigned st=99;ck(hipMemcpy(lo.data(),c.lo.p,lo.size(),hipMemcpyDeviceToHost),"lo");ck(hipMemcpy(hi.data(),c.hi.p,hi.size(),hipMemcpyDeviceToHost),"hi");ck(hipMemcpy(s.data(),c.s.p,s.size()*2,hipMemcpyDeviceToHost),"scale");ck(hipMemcpy(&st,c.st.p,4,hipMemcpyDeviceToHost),"status");unsigned groups=x.k/64;for(unsigned m=0;m<t;++m)for(unsigned g=0;g<groups;++g){if(s[gs(g,m,t)]!=h.s[std::size_t(m)*groups+g])throw std::runtime_error("scale codec");for(unsigned j=0;j<32;++j){auto old=std::size_t(m)*x.k/2+g*32+j,neu=gm(g,m,j,t);if(lo[neu]!=h.lo[old]||hi[neu]!=h.hi[old])throw std::runtime_error("code codec");}}if(st!=h.status)throw std::runtime_error("status codec");}
void bit_equal(Cand&c,Ctrl&b){std::vector<hip_bfloat16>x(c.logical),y(c.logical);ck(hipMemcpy(x.data(),c.outp,x.size()*2,hipMemcpyDeviceToHost),"candidate out");ck(hipMemcpy(y.data(),b.out.p,y.size()*2,hipMemcpyDeviceToHost),"control out");for(std::size_t i=0;i<x.size();++i)if(x[i].data!=y[i].data)throw std::runtime_error("full output bit parity");}
void oracle_samples(const Shape&x,unsigned t,const HA&a,const HW&w,Cand&c){std::vector<hip_bfloat16>out(c.logical);ck(hipMemcpy(out.data(),c.outp,out.size()*2,hipMemcpyDeviceToHost),"oracle out");unsigned groups=x.k/64;for(unsigned z=0;z<20;++z){unsigned m=(z*103U)%t,n=(z*997U)%x.n;double total=0;for(unsigned g=0;g<groups;++g){int dot=0;for(unsigned p=0;p<4;++p){auto ww=w.w[wi(n,g,p,groups)];for(unsigned j=0;j<16;++j){unsigned k=g*64+p*16+j,o=(std::size_t(m)*x.k+k)/2,sh=(k&1)*4;int aq=un(a.lo[o],sh)+16*sn(a.hi[o],sh),wq=(ww>>(4*j))&15;if(wq>=8)wq-=16;dot+=aq*wq;}}total=std::fma(double(dot),double(hf(a.s[std::size_t(m)*groups+g]))*hf(w.s[si(n,g,groups)]),total);}hip_bfloat16 expected{float(total)};unsigned d=out[std::size_t(m)*x.n+n].data>expected.data?out[std::size_t(m)*x.n+n].data-expected.data:expected.data-out[std::size_t(m)*x.n+n].data;if(d>2)throw std::runtime_error("represented FP64 oracle");}}
void invalid_no_clobber(const Shape&x,const Dev<hip_bfloat16>&in,Cand&c){auto good=args(x,1,in,c);ck(hipMemset(c.out.p,0x55,c.out.n*2),"guard poison");std::vector<hip_bfloat16>before(c.out.n),after(c.out.n);ck(hipMemcpy(before.data(),c.out.p,c.out.n*2,hipMemcpyDeviceToHost),"guard before");auto reject=[&](A8Q4GroupMajorArgs b){if(a8q4_group_major_activation_run(b,nullptr)!=hipErrorInvalidValue)throw std::runtime_error("invalid accepted");ck(hipMemcpy(after.data(),c.out.p,c.out.n*2,hipMemcpyDeviceToHost),"guard after");for(std::size_t i=0;i<before.size();++i)if(before[i].data!=after[i].data)throw std::runtime_error("invalid clobber");};
 auto b=good;b.input=nullptr;reject(b);b=good;b.activation_low=nullptr;reject(b);b=good;b.activation_high=nullptr;reject(b);b=good;b.activation_scales=nullptr;reject(b);b=good;b.activation_status=nullptr;reject(b);b=good;b.weight_codes=nullptr;reject(b);b=good;b.weight_scales=nullptr;reject(b);b=good;b.output=nullptr;reject(b);
 b=good;b.input=reinterpret_cast<const hip_bfloat16*>(reinterpret_cast<std::uintptr_t>(b.input)+1);reject(b);b=good;b.activation_low++;reject(b);b=good;b.activation_high++;reject(b);b=good;b.activation_scales=reinterpret_cast<std::uint16_t*>(reinterpret_cast<std::uintptr_t>(b.activation_scales)+1);reject(b);b=good;b.activation_status=reinterpret_cast<std::uint32_t*>(reinterpret_cast<std::uintptr_t>(b.activation_status)+1);reject(b);b=good;b.weight_codes++;reject(b);b=good;b.weight_scales=reinterpret_cast<std::uint16_t*>(reinterpret_cast<std::uintptr_t>(b.weight_scales)+1);reject(b);b=good;b.output=reinterpret_cast<hip_bfloat16*>(reinterpret_cast<std::uintptr_t>(b.output)+1);reject(b);
 b=good;--b.input_bytes;reject(b);b=good;--b.activation_plane_bytes;reject(b);b=good;--b.activation_scale_bytes;reject(b);b=good;--b.weight_code_bytes;reject(b);b=good;--b.weight_scale_bytes;reject(b);b=good;--b.output_bytes;reject(b);
 b=good;b.activation_high=b.activation_low;reject(b);b=good;b.activation_scales=reinterpret_cast<std::uint16_t*>(b.activation_low);reject(b);b=good;b.activation_status=reinterpret_cast<std::uint32_t*>(b.activation_low);reject(b);b=good;b.weight_codes=b.activation_low;reject(b);b=good;b.weight_scales=reinterpret_cast<std::uint16_t*>(b.activation_low);reject(b);b=good;b.output=reinterpret_cast<hip_bfloat16*>(b.activation_low);reject(b);b=good;b.tokens=5;reject(b);}
void output_canaries(Cand&c);
void graph(const Shape&x,const Dev<hip_bfloat16>&in,Cand&c,const HA&a,const HW&w){Stream s;hipGraph_t g{};hipGraphExec_t e{};ck(hipStreamBeginCapture(s.p,hipStreamCaptureModeGlobal),"capture");candidate(x,1,in,c,s.p);ck(hipStreamEndCapture(s.p,&g),"end capture");ck(hipGraphInstantiate(&e,g,nullptr,nullptr,0),"instantiate");ck(hipMemset(c.outp,0x55,c.logical*2),"poison graph");ck(hipGraphLaunch(e,s.p),"graph1");ck(hipGraphLaunch(e,s.p),"graph2");ck(hipStreamSynchronize(s.p),"graph sync");oracle_samples(x,1,a,w,c);output_canaries(c);(void)hipGraphExecDestroy(e);(void)hipGraphDestroy(g);}
void output_canaries(Cand&c){std::array<hip_bfloat16,16>pre{};std::array<hip_bfloat16,32>post{};ck(hipMemcpy(pre.data(),c.out.p,pre.size()*2,hipMemcpyDeviceToHost),"prefix");ck(hipMemcpy(post.data(),c.outp+c.logical,post.size()*2,hipMemcpyDeviceToHost),"suffix");for(auto v:pre)if(v.data!=0x5555)throw std::runtime_error("prefix canary");for(auto v:post)if(v.data!=0x5555)throw std::runtime_error("suffix canary");}
void regression(){for(int q=-127;q<=127;++q){int l=q&15,h=(q-l)/16;if(l+16*h!=q||h< -8||h>7)throw std::runtime_error("nibble invariant");}for(const auto&x:kShapes){unsigned ts[2]={1,2048};for(unsigned t:ts){auto iv=input(x,t,false);auto ah=hostq(x,t,iv);auto wh=weights(x,false);Stream route;Dev<hip_bfloat16>di(iv.size());put(di,iv);Cand c(t,x);Ctrl b(t,x);uploadw(wh,c,b);ck(hipMemset(c.out.p,0x55,c.out.n*2),"tail poison");candidate(x,t,di,c,route.p);control(x,t,di,b,route.p);ck(hipStreamSynchronize(route.p),"sync");codec(x,t,ah,c);bit_equal(c,b);oracle_samples(x,t,ah,wh,c);output_canaries(c);if(t==1){invalid_no_clobber(x,di,c);graph(x,di,c,ah,wh);auto bad=iv;bad[0].data=0x7fc1;put(di,bad);candidate(x,t,di,c,route.p);ck(hipStreamSynchronize(route.p),"bad sync");unsigned st=0;hip_bfloat16 o{};ck(hipMemcpy(&st,c.st.p,4,hipMemcpyDeviceToHost),"bad status");ck(hipMemcpy(&o,c.outp,2,hipMemcpyDeviceToHost),"bad output");if(!(st&1)||o.data!=0x7fc1)throw std::runtime_error("nonfinite status");}}}std::cout<<"PASS shapes=3 T1_all_roles=true P2048=true codec_exact=true full_output_bit_parity=true represented_fp64_samples=20 maximum_bf16_steps=2 full_null_alignment_span_selected_overlap_output_no_clobber=true output_prefix_suffix_canaries=true nonfinite_status_all_roles=true graph_replays=2\n";}
template<class F>double elapsed(F f,unsigned it,hipStream_t s){for(unsigned i=0;i<3;++i)f();ck(hipStreamSynchronize(s),"warmup");hipEvent_t a,b;ck(hipEventCreate(&a),"event");ck(hipEventCreate(&b),"event");ck(hipEventRecord(a,s),"start");for(unsigned i=0;i<it;++i)f();ck(hipEventRecord(b,s),"stop");ck(hipEventSynchronize(b),"event sync");float ms;ck(hipEventElapsedTime(&ms,a,b),"elapsed");(void)hipEventDestroy(a);(void)hipEventDestroy(b);return ms;}
void arr(const std::array<double,kTrials>&a){std::cout<<"[";for(unsigned i=0;i<kTrials;++i){if(i)std::cout<<",";std::cout<<a[i];}std::cout<<"]";}
void benchmark(){int dev=-1,rv=0,dv=0;hipDeviceProp_t p{};ck(hipGetDevice(&dev),"device");ck(hipGetDeviceProperties(&p,dev),"props");ck(hipRuntimeGetVersion(&rv),"runtime");ck(hipDriverGetVersion(&dv),"driver");std::cout<<std::setprecision(12)<<"{\"schema_version\":1,\"status\":\"measured\",\"device\":{\"ordinal\":"<<dev<<",\"name\":\""<<p.name<<"\",\"architecture\":\""<<p.gcnArchName<<"\",\"runtime_version\":"<<rv<<",\"driver_version\":"<<dv<<"},\"warmups\":3,\"launches_per_interval\":128,\"alternating_trials\":14,\"cells\":[";bool first=true;for(const auto&x:kShapes){auto iv=input(x,2048,true);auto wh=weights(x,true);Dev<hip_bfloat16>di(iv.size());put(di,iv);Cand c(2048,x);Ctrl b(2048,x);uploadw(wh,c,b);Stream s;auto cf=[&]{candidate(x,2048,di,c,s.p);};auto bf=[&]{control(x,2048,di,b,s.p);};std::array<double,kTrials>ca{},ba{};for(unsigned q=0;q<kTrials;++q)if(q&1){ca[q]=elapsed(cf,128,s.p);ba[q]=elapsed(bf,128,s.p);}else{ba[q]=elapsed(bf,128,s.p);ca[q]=elapsed(cf,128,s.p);}if(!first)std::cout<<",";first=false;std::cout<<"{\"role\":\""<<x.role<<"\",\"tokens\":2048,\"rows\":"<<x.n<<",\"columns\":"<<x.k<<",\"calls\":"<<x.calls<<",\"control_samples_ms\":";arr(ba);std::cout<<",\"candidate_samples_ms\":";arr(ca);std::cout<<"}";}std::cout<<"]}\n";}
}
int main(int ac,char**av){try{int d=-1;hipDeviceProp_t p{};ck(hipGetDevice(&d),"device");ck(hipGetDeviceProperties(&p,d),"props");if(d!=0||std::string(p.gcnArchName).find("gfx1201")!=0||std::string(p.name).find("R9700")==std::string::npos)throw std::runtime_error("requires device0 R9700 gfx1201");if(ac!=2)throw std::runtime_error("usage --regression|--benchmark");if(std::string(av[1])=="--regression")regression();else if(std::string(av[1])=="--benchmark")benchmark();else throw std::runtime_error("mode");return 0;}catch(const std::exception&e){std::cerr<<"FAIL "<<e.what()<<"\n";return 1;}}
